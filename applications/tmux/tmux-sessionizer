#!/usr/bin/env bash

function usage() {
    cat <<EOF
Usage: $0 [-a] [-h]
    -a:     pick a repo under \$REPOS and open its session
    -h:     show this help
EOF
    exit 1
}

# Repo paths relative to $REPOS, e.g. personal/foo
function pick_repo() {
    fd .git \
        --hidden \
        --no-ignore \
        --type directory \
        --prune \
        --glob \
        --base-directory "$REPOS" \
        --format '{//}' |
        sort --reverse |
        fzf
}

selected=""
while getopts "ah" opt; do
    case $opt in
    a) selected=$(pick_repo) || exit 0 ;;
    *) usage ;;
    esac
done
[[ $OPTIND -eq 1 ]] && usage
[[ -z $selected ]] && exit 0

# Relative path keeps work/api and personal/api apart; tmux disallows '.' in session names.
name=${selected//./_}

if ! tmux has-session -t="$name" 2>/dev/null; then
    tmux new-session -ds "$name" -c "$REPOS/$selected"
    tmux send-keys -t="$name:" "vim ." Enter
fi

if [[ -z ${TMUX:-} ]]; then
    exec tmux attach-session -t="$name"
fi
tmux switch-client -t="$name"
